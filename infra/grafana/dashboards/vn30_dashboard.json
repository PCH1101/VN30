{
  "__inputs": [
    {
      "name": "DS_CLICKHOUSE_VN30",
      "label": "ClickHouse-VN30",
      "description": "ClickHouse data warehouse cho VN30 ETL",
      "type": "datasource",
      "pluginId": "grafana-clickhouse-datasource",
      "pluginName": "ClickHouse"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-clickhouse-datasource",
      "name": "ClickHouse",
      "version": "3.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "VN30 Stock ETL Pipeline — Realtime Market Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Nen 1 Phut (Intraday Candlestick)",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "gradientMode": "opacity"
          },
          "color": { "mode": "palette-classic" },
          "unit": "currencyVND"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "open" },
            "properties": [{ "id": "displayName", "value": "Mo cua" }]
          },
          {
            "matcher": { "id": "byName", "options": "high" },
            "properties": [{ "id": "displayName", "value": "Cao nhat" }]
          },
          {
            "matcher": { "id": "byName", "options": "low" },
            "properties": [{ "id": "displayName", "value": "Thap nhat" }]
          },
          {
            "matcher": { "id": "byName", "options": "close" },
            "properties": [{ "id": "displayName", "value": "Dong cua" }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
          "rawSql": "SELECT window_start AS time, open, high, low, close, volume FROM vn30.gold_ohlcv_1min FINAL WHERE ticker = '$ticker' AND window_start >= $__fromTime AND window_start <= $__toTime ORDER BY time ASC",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "title": "Nen 1 Phut - $ticker",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500000 },
              { "color": "red", "value": 2000000 }
            ]
          }
        }
      },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
          "rawSql": "SELECT window_start AS time, volume FROM vn30.gold_ohlcv_1min FINAL WHERE ticker = '$ticker' AND window_start >= $__fromTime AND window_start <= $__toTime ORDER BY time DESC LIMIT 1",
          "format": "time_series",
          "refId": "B"
        }
      ],
      "title": "Volume 1 Phut Hien Tai - $ticker",
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 101,
      "title": "VN30 Heatmap - Do Rong Thi Truong",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d44a3a", "value": null },
              { "color": "#e5ac0e", "value": -1 },
              { "color": "#299c46", "value": 0.5 }
            ]
          },
          "unit": "percent",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 3,
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
          "rawSql": "SELECT ticker, price_change_pct AS value FROM vn30.silver_daily_ohlcv FINAL WHERE trade_date = today() ORDER BY ticker ASC",
          "format": "table",
          "refId": "C"
        }
      ],
      "title": "VN30 Heatmap - Bien Dong Gia Hom Nay (%)",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 102,
      "title": "Dong Tien Rong (Net Money Flow)",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1,
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "buy_volume" },
            "properties": [
              { "id": "displayName", "value": "Mua" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "sell_volume" },
            "properties": [
              { "id": "displayName", "value": "Ban" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "id": 4,
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
          "rawSql": "SELECT window_start AS time, sumIf(volume, action='BUY') AS buy_volume, sumIf(volume, action='SELL') AS sell_volume FROM vn30.silver_intraday_ticks WHERE toDate(match_time) = today() AND match_time >= $__fromTime AND match_time <= $__toTime GROUP BY window_start ORDER BY time ASC",
          "format": "time_series",
          "refId": "D"
        }
      ],
      "title": "Net Money Flow Toan Ro VN30 - Theo Phut",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
      "id": 5,
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
          "rawSql": "SELECT ticker, count() AS alert_count FROM vn30.alert_log WHERE toDate(alert_time) = today() GROUP BY ticker ORDER BY alert_count DESC LIMIT 10",
          "format": "table",
          "refId": "E"
        }
      ],
      "title": "Top 10 Ma Co Alert Hom Nay",
      "type": "barchart"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["vn30", "stock", "etl"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
        "definition": "SELECT DISTINCT ticker FROM vn30.silver_daily_ohlcv ORDER BY ticker",
        "hide": 0,
        "includeAll": true,
        "label": "Ma Co Phieu",
        "multi": true,
        "name": "ticker",
        "options": [],
        "query": "SELECT DISTINCT ticker FROM vn30.silver_daily_ohlcv ORDER BY ticker",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },

  "time": { "from": "2026-07-01T00:00:00.000Z", "to": "2026-07-31T23:59:59.000Z" },

  "timepicker": {},
  "timezone": "Asia/Ho_Chi_Minh",
  "title": "VN30 ETL Pipeline Dashboard",
  "uid": "vn30-etl-main",
  "version": 2,
  "weekStart": "monday",
  "panels_extra": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "id": 103,
      "title": "VWAP Signal (UC3)",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5,
            "lineWidth": 2
          },
          "unit": "currencyVND",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "close" },
            "properties": [
              { "id": "displayName", "value": "Gia dong cua" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "vwap" },
            "properties": [
              { "id": "displayName", "value": "VWAP" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 18, "x": 0, "y": 38 },
      "id": 6,
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
          "rawSql": "SELECT window_start AS time, close, sumIf(close * volume, 1) OVER (PARTITION BY ticker ORDER BY window_start) / sumIf(volume, 1) OVER (PARTITION BY ticker ORDER BY window_start) AS vwap FROM vn30.gold_ohlcv_1min FINAL WHERE ticker = '$ticker' AND window_start >= $__fromTime AND window_start <= $__toTime ORDER BY time ASC",
          "format": "time_series",
          "refId": "F"
        }
      ],
      "title": "Gia vs VWAP - $ticker",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ticker" }, "properties": [{ "id": "displayName", "value": "Ma" }] },
          { "matcher": { "id": "byName", "options": "alert_type" }, "properties": [{ "id": "displayName", "value": "Loai Alert" }] },
          { "matcher": { "id": "byName", "options": "alert_time" }, "properties": [{ "id": "displayName", "value": "Thoi Gian" }] },
          { "matcher": { "id": "byName", "options": "buy_ratio" }, "properties": [{ "id": "displayName", "value": "Buy Ratio" }, { "id": "unit", "value": "percentunit" }] }
        ]
      },
      "gridPos": { "h": 10, "w": 6, "x": 18, "y": 38 },
      "id": 7,
      "options": {
        "sortBy": [{ "displayName": "Thoi Gian", "desc": true }],
        "footer": { "show": false }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
          "rawSql": "SELECT alert_time, ticker, alert_type, round(buy_ratio, 2) AS buy_ratio FROM vn30.alert_log WHERE toDate(alert_time) = today() ORDER BY alert_time DESC LIMIT 20",
          "format": "table",
          "refId": "G"
        }
      ],
      "title": "Alert Log Hom Nay",
      "type": "table"
    }
  ]
}
