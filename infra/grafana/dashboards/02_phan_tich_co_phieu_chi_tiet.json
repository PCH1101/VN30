      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-vn30" },
          "rawSql": "SELECT DISTINCT formatDateTime(match_time, '%H:%i:%s') AS `Thời Gian`, round(price * 1000, 0) AS `Giá Khớp`, volume AS `Khối Lượng`, action AS `Lệnh Mua/Bán` FROM vn30.raw_intraday_ticks WHERE ticker = '${ticker}' ORDER BY match_time DESC LIMIT 50",
