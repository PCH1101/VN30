# =============================================================================
# VN30 ETL Pipeline — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=vn30
CLICKHOUSE_USER=vn30_user
CLICKHOUSE_PASSWORD=your_clickhouse_password_here

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INTRADAY=vn30.intraday.ticks
KAFKA_TOPIC_OHLCV=vn30.daily.ohlcv

# --- Telegram Bot ---
TELEGRAM_TOKEN=your_bot_token_from_botfather_here

# --- Airflow & Postgres ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=your_airflow_admin_password_here

# --- Vnstock API ---
VNSTOCK_SOURCE=KBS
VNSTOCK_API_KEY=your_vnstock_api_key_here
VNSTOCK_TIMEOUT=30
VNSTOCK_SHOW_LOG=false

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here
