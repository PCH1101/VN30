# =============================================================================
# VN30 ETL Pipeline — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=vn30
CLICKHOUSE_USER=vn30_user
CLICKHOUSE_PASSWORD=your_clickhouse_password_here

# --- MinIO (S3-Compatible Object Storage) ---
MINIO_ENDPOINT=localhost:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_here
MINIO_SECURE=false
MINIO_BUCKET_BRONZE=vn30-bronze

# --- Telegram Bot ---
TELEGRAM_TOKEN=your_bot_token_from_botfather_here

# --- Airflow & Postgres ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=your_airflow_admin_password_here

# --- Vnstock API ---
VNSTOCK_SOURCE=TCBS
VNSTOCK_API_KEY=your_vnstock_api_key_here
VNSTOCK_TIMEOUT=30
VNSTOCK_SHOW_LOG=false

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# --- MinIO Docker credentials (must match MINIO_ above) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_secret_here
