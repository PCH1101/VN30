# =============================================================================
# VN30 ETL Pipeline — .gitignore
# =============================================================================

# Environment secrets — NEVER commit
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.venv/
venv/
env/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docker local state
docker-compose.override.yml

# Data files (không commit raw data)
*.parquet
*.csv
data/

# Logs
*.log
logs/

# Grafana exports (có thể commit dashboard JSON, nhưng không commit local state)
infra/grafana/grafana.db

# dbt
transform/target/
transform/dbt_packages/
transform/dbt_modules/
transform/.user.yml
